{
  "expo": {
    "name": "FutureMe",
    "slug": "future-me",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "futureme",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.futureme.app",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "FutureMe uses notifications to remind you about saved items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "package": "com.futureme.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1f0c5206-aa07-424e-9062-c6a7d7c1e90e"
      }
    }
  }
}
